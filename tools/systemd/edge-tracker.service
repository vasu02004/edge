[Unit]
Description=Edge vault tracker (ArUco + open/close detection)
After=network.target

[Service]
Type=simple
# Adjust User/WorkingDirectory/ExecStart if your user, repo path, or venv
# path differ from this.
User=root
WorkingDirectory=/root/edge
ExecStart=/root/edge/venv/bin/python3 main.py --stream
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
