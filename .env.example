BRANCH_ID=branch_001
CAMERA_SOURCE=0
FRAME_WIDTH=640
FRAME_HEIGHT=360
ARUCO_DICTIONARY=DICT_6X6_250
AURUS_GUARD_BASE_URL=http://localhost:3000/api/v1
AURUS_GUARD_DEV_USER_PROFILE={"id":"edge-tracker","roles":[{"name":"agent"}]}

# Event publishing over MQTT. Leave MQTT_BROKER_URL blank to disable entirely.
# The Pi only ever publishes here — storage and notification decisions (Google
# Chat, PagerDuty, etc.) live in the backend, not on the device.
MQTT_BROKER_URL=
MQTT_EVENTS_TOPIC=vault/events
# Username/password auth (e.g. a plain test broker):
MQTT_USERNAME=
MQTT_PASSWORD=
# X.509 device-certificate auth (AWS IoT Core) — takes precedence over
# username/password above when MQTT_CERT_PATH is set:
MQTT_CA_PATH=
MQTT_CERT_PATH=
MQTT_KEY_PATH=

# Raw camera recording + upload (only applies when CAMERA_SOURCE is a local
# device, e.g. 0 or /dev/video0 — ignored for an HTTP camera source). Requires
# ffmpeg with the h264_v4l2m2m encoder and rclone with DRIVE_REMOTE configured
# for whichever user runs main.py.
RECORDING_ENABLED=true
RECORDINGS_DIR=/home/raspberry/recordings
DRIVE_REMOTE=gdrive:
RECORDING_WIDTH=1920
RECORDING_HEIGHT=1080
RECORDING_BITRATE=8M
RECORDING_SEGMENT_SECONDS=900
RECORDING_MIN_UPLOAD_AGE_SECONDS=30
RECORDING_UPLOAD_INTERVAL_SECONDS=60
CAMERA_AUTO_EXPOSURE=3
CAMERA_BRIGHTNESS=0
ACTIVE_HOURS_START=08:45
ACTIVE_HOURS_END=18:45
