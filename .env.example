BRANCH_ID=branch_001
CAMERA_SOURCE=0
FRAME_WIDTH=640
FRAME_HEIGHT=360
ARUCO_DICTIONARY=DICT_6X6_250
AURUS_GUARD_BASE_URL=http://localhost:3000/api/v1
AURUS_GUARD_DEV_USER_PROFILE={"id":"edge-tracker","roles":[{"name":"agent"}]}

# Event publishing over MQTT (same broker/creds as aurusguard-pi's bridge.js).
# Leave MQTT_BROKER_URL blank to disable event publishing entirely.
MQTT_BROKER_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_EVENTS_TOPIC=vault/events

# Google Chat webhook for human-reviewer notifications, one message per event
# (validation phase — reviewers cross-check each against CCTV footage). Blank
# disables notifications entirely.
GOOGLE_CHAT_WEBHOOK_URL=
